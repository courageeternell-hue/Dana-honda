{
  "expo": {
    "name": "Asisten Sales",
    "slug": "tasya",
    "scheme": "hondasales",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "updates": {
      "url": "https://u.expo.dev/fd9bfa1d-db87-406f-8e61-7b053dbc0c45",
      "enabled": true,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "android": {
      "package": "com.danz.hondasales",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/dana-honda-icon-square.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan Asisten Sales mengakses galeri untuk mengganti foto profil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/dana-honda-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "fd9bfa1d-db87-406f-8e61-7b053dbc0c45"
      }
    },
    "owner": "ichatasya",
    "icon": "./assets/dana-honda-icon-square.png"
  }
}
