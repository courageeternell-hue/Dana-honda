{
  "expo": {
    "name": "Asisten Sales",
    "slug": "dana-honda",
    "scheme": "hondasales",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.danz.hondasales",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/dana-honda-icon-square.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan Asisten Sales mengakses galeri untuk mengganti foto profil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/dana-honda-icon-square.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "369cb3cb-3f36-4b61-ab82-813f340aab0c"
      }
    },
    "owner": "courage",
    "icon": "./assets/dana-honda-icon-square.png"
  }
}