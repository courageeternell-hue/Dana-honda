{
  "expo": {
    "name": "Asisten Sales",
    "slug": "zerooo",
    "scheme": "hondasales",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.danz.hondasales",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan Asisten Sales mengakses galeri untuk mengganti foto profil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/dana-honda-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "3a95d921-61c2-4c7b-8e69-549a24a66c9d"
      }
    },
    "owner": "irhamdi"
  }
}
