{
  "expo": {
    "name": "Asisten Sales",
    "slug": "dana-honda",
    "scheme": "hondasales",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.danz.hondasales",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/dana-honda-icon-square.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan Asisten Sales mengakses galeri untuk mengganti foto profil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/dana-honda-icon-square.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "163d62d3-1079-4811-bb1e-a8010d13f9c6"
      }
    },
    "owner": "irhamdi",
    "icon": "./assets/dana-honda-icon-square.png"
  }
}